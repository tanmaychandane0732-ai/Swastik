# =====================================================================
# FinQuest Financial Flight Control Server — Environment Configuration
# =====================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Database Configuration (MongoDB via Prisma ORM)
# ---------------------------------------------------------------------
# Option 1: Local MongoDB (Community Edition running on port 27017)
DATABASE_URL="mongodb://localhost:27017/finquest?serverSelectionTimeoutMS=2000"

# Option 2: MongoDB Atlas (Free Cloud Cluster — Recommended for Teams)
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
# DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/finquest?retryWrites=true&w=majority"

# ---------------------------------------------------------------------
# Security & Auth Tokens
# ---------------------------------------------------------------------
# Required in production; use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------
# AI Co-Pilot (Google Gemini API — Optional)
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# Debugging (Optional: Set to true for raw Prisma engine query logs)
PRISMA_DEBUG=false
