generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                @id @default(uuid())
  name           String
  email          String                @unique
  passwordHash   String
  ageGroup       String?               @default("18-25")
  educationLevel String?               @default("Undergraduate")
  location       String?               @default("India")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  profile        UserProfile?
  sessions       GameSession[]
  assessments    FinancialAssessment[]
  badges         UserBadge[]
  challenges     ChallengeAttempt[]
  classroomRoles ClassroomMember[]
  teachingClasses Classroom[]         @relation("TeacherClassrooms")

  @@map("users")
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialIQ      Int      @default(50)
  decisionDNA      Json?    // Archetype and 5 traits (patience, risk, debt, scam, emergency)
  financialHealth  Int      @default(75)
  riskScore        Int      @default(20)
  learningProgress Json?    // Modules completed, mastery levels
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_profiles")
}

model Scenario {
  id          String           @id @default(uuid())
  title       String
  subtitle    String?
  description String
  category    String           @default("budget") // budget, debt, investment, scam, shock
  difficulty  String           @default("cadet")  // cadet, investigator, master
  country     String           @default("IN")     // Indian context default
  isActive    Boolean          @default(true)
  month       Int              @default(1)
  createdAt   DateTime         @default(now())

  options     ScenarioOption[]
  decisions   Decision[]

  @@map("scenarios")
}

model ScenarioOption {
  id                 String     @id @default(uuid())
  scenarioId         String
  scenario           Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  text               String
  description        String
  cashImpact         Int        @default(0)
  debtImpact         Int        @default(0)
  savingsImpact      Int        @default(0)
  creditImpact       Int        @default(0)
  riskImpact         Int        @default(0)
  scoreImpact        Int        @default(0)
  healthImpact       Int        @default(0)
  monthlyEmiImpact   Int        @default(0)
  isOptimal          Boolean    @default(false)
  outcomeHeadline    String
  outcomeExplanation String
  financialLesson    String

  decisions          Decision[]

  @@map("scenario_options")
}

model GameSession {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentMonth    Int        @default(1)
  totalMonths     Int        @default(6)
  status          String     @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED, ABANDONED
  startingCash    Int        @default(10000)
  currentCash     Int        @default(10000)
  savings         Int        @default(0)
  debt            Int        @default(0)
  monthlyEmi      Int        @default(0)
  invested        Int        @default(0)
  creditScore     Int        @default(680)
  financialHealth Int        @default(75)
  riskScore       Int        @default(20)
  overallScore    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?

  decisions       Decision[]

  @@map("game_sessions")
}

model Decision {
  id                   String         @id @default(uuid())
  sessionId            String
  session              GameSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scenarioId           String
  scenario             Scenario       @relation(fields: [scenarioId], references: [id])
  optionId             String
  option               ScenarioOption @relation(fields: [optionId], references: [id])
  month                Int
  cashBefore           Int
  cashAfter            Int
  debtBefore           Int
  debtAfter            Int
  riskBefore           Int
  riskAfter            Int
  financialHealthBefore Int
  financialHealthAfter Int
  netWorthBefore       Int
  netWorthAfter        Int
  isOptimal            Boolean
  headline             String
  whyItHappened        String
  financialLesson      String
  createdAt            DateTime       @default(now())

  @@map("decisions")
}

model FinancialAssessment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String   // PRE_QUEST, POST_QUEST
  score          Int      @default(0)
  categoryScores Json     // { budget: 70, debt: 60, scam: 80, investing: 50, insurance: 60 }
  tier           String   // Pre-Flight Cadet, Co-Pilot in Training, Licensed Aviator, Elite Commander
  completedAt    DateTime @default(now())

  @@map("financial_assessments")
}

model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String
  icon        String
  category    String      @default("flight") // flight, budget, debt, scam, mastery

  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model DailyChallenge {
  id            String             @id @default(uuid())
  date          String             @unique // YYYY-MM-DD
  scenario      String
  question      String
  explanation   String
  learningPoint String
  options       Json               // Array of choices with id, text, isOptimal, rationale
  createdAt     DateTime           @default(now())

  attempts      ChallengeAttempt[]

  @@map("daily_challenges")
}

model ChallengeAttempt {
  id          String         @id @default(uuid())
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId    String
  isOptimal   Boolean
  attemptedAt DateTime       @default(now())

  @@unique([challengeId, userId])
  @@map("challenge_attempts")
}

model Classroom {
  id          String            @id @default(uuid())
  name        String
  institution String
  code        String            @unique
  teacherId   String
  teacher     User              @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  createdAt   DateTime          @default(now())

  members     ClassroomMember[]
  assignments Assignment[]

  @@map("classrooms")
}

model ClassroomMember {
  id          String    @id @default(uuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("student") // student, ta, teacher
  joinedAt    DateTime  @default(now())

  @@unique([classroomId, userId])
  @@map("classroom_members")
}

model Assignment {
  id           String    @id @default(uuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title        String
  scenarioPack String    @default("indian")
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  @@map("assignments")
}

